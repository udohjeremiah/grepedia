{
  "name": "@workspace/transactional",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "email dev -d src/emails -p 3001",
    "build": "rimraf dist && tsc && tsc-alias",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./build-email": {
      "types": "./dist/build-email.d.ts",
      "default": "./dist/build-email.js"
    },
    "./emails/change-email-confirmation-email": {
      "types": "./dist/emails/change-email-confirmation-email.d.ts",
      "default": "./dist/emails/change-email-confirmation-email.js"
    },
    "./emails/delete-account-verification-email": {
      "types": "./dist/emails/delete-account-verification-email.d.ts",
      "default": "./dist/emails/delete-account-verification-email.js"
    },
    "./emails/reset-password-email": {
      "types": "./dist/emails/reset-password-email.d.ts",
      "default": "./dist/emails/reset-password-email.js"
    },
    "./emails/verification-email": {
      "types": "./dist/emails/verification-email.d.ts",
      "default": "./dist/emails/verification-email.js"
    }
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "react-email": "6.5.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  }
}
