{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "app.ts",
  "scripts": {
    "dev": "tsc && tsc-alias && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:build:watch\" \"pnpm:dev:start\"",
    "dev:start": "fastify start --trust-proxy-enabled --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "build": "rimraf dist && tsc && tsc-alias",
    "build:watch": "tsc && concurrently -k \"tsc -w\" \"tsc-alias -w\"",
    "start": "pnpm run build && fastify start --trust-proxy-enabled -l info dist/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "docker:start": "docker compose -f compose.dev.yaml up -d",
    "docker:build": "docker compose -f compose.dev.yaml build",
    "docker:build:nocache": "docker compose -f compose.dev.yaml build --no-cache",
    "docker:clean": "docker compose -f compose.dev.yaml down",
    "docker:clean:images": "docker compose -f compose.dev.yaml down --rmi all",
    "docker:clean:volumes": "docker compose -f compose.dev.yaml down -v",
    "docker:clean:all": "docker compose -f compose.dev.yaml down --rmi all -v"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^6.0.0",
    "@fastify/mongodb": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@google/genai": "^2.8.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@workspace/shared": "workspace:*",
    "@workspace/transactional": "workspace:*",
    "better-auth": "^1.6.18",
    "crawlee": "^3.17.0",
    "fastify": "^5.8.5",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^7.2.0",
    "resend": "^6.12.4",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/turndown": "^5.0.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.17",
    "typescript": "~6.0.3"
  }
}
