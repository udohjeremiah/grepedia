{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "app.ts",
  "scripts": {
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:build:watch\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && concurrently -k \"tsc -w\" \"tsc-alias -w\"",
    "start": "npm run build && fastify start -l info dist/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.32.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.2"
  }
}
