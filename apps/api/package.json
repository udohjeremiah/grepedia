{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "app.ts",
  "scripts": {
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:build:watch\" \"pnpm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "build": "rimraf dist && tsc && tsc-alias",
    "build:watch": "tsc && concurrently -k \"tsc -w\" \"tsc-alias -w\"",
    "start": "pnpm run build && fastify start -l info dist/app.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "docker:start": "docker compose -f compose.dev.yaml up -d",
    "docker:build": "docker compose -f compose.dev.yaml build",
    "docker:build:nocache": "docker compose -f compose.dev.yaml build --no-cache",
    "docker:clean": "docker compose -f compose.dev.yaml down",
    "docker:clean:images": "docker compose -f compose.dev.yaml down --rmi all",
    "docker:clean:volumes": "docker compose -f compose.dev.yaml down -v",
    "docker:clean:all": "docker compose -f compose.dev.yaml down --rmi all -v"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/mongodb": "^9.0.2",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@sindresorhus/slugify": "^3.0.0",
    "@workspace/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.4.10",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^6.5.0",
    "resend": "^6.7.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.0.0",
    "eslint": "^9.32.0",
    "rimraf": "^6.1.2",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.2"
  }
}
